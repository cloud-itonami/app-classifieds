{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "dc4602dc17bce8f6e9ba038e92b3e95fcc411b49"}}
 :aliases
 {:build {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}
          :main-opts ["-m" "cljs.main" "-co" "build.edn" "-c" "classifieds.browser"]}
  :render {:main-opts ["-m" "classifieds.render"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
