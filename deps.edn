{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "dc4602dc17bce8f6e9ba038e92b3e95fcc411b49"}
        io.github.kotoba-lang/org-signal
        {:git/url "https://github.com/kotoba-lang/org-signal"
         :git/sha "511e4b47de5d17945aa02815725703e8eb52bdef"}}
 :aliases
 {:build {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}}
          :main-opts ["-m" "shadow.cljs.devtools.cli" "release" "app"]}
  :render {:main-opts ["-m" "classifieds.render"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
