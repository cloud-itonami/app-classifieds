{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-itonami-app-classifieds",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/health", "/.well-known/agent-card.json", "/mcp", "/a2a", "/message:send", "/api/*"]
  },
  "services": [
    { "binding": "SETTLEMENT", "service": "cloud-itonami-marketplace-settlement" },
    { "binding": "FULFILLMENT", "service": "cloud-itonami-marketplace-fulfillment" }
  ],
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "cloud-itonami-app-classifieds-production",
      "services": [
        { "binding": "SETTLEMENT", "service": "cloud-itonami-marketplace-settlement" },
        { "binding": "FULFILLMENT", "service": "cloud-itonami-marketplace-fulfillment" }
      ],
      "observability": { "enabled": true }
    }
  }
}
